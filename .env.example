# Copy to .env and fill in. Never commit .env.

# --- Mattermost ---
# Base URL of Mattermost as seen from inside Docker (service name + port).
MM_URL=http://mattermost:8065
# Access token of the `attendance` bot (System Console → Integrations → Bot Accounts).
MM_BOT_TOKEN=
# Name of the existing Docker network Mattermost is on (`docker network ls`).
MM_DOCKER_NETWORK=mattermost_default

# --- Database ---
POSTGRES_PASSWORD=
# DATABASE_URL is built by docker-compose.yml from POSTGRES_PASSWORD.
# Set it yourself only when running outside compose:
# DATABASE_URL=postgres://attendance:PASSWORD@localhost:5432/attendance?sslmode=disable

# --- Service ---
LISTEN_ADDR=:8080
TIMEZONE=Asia/Kolkata
# Signs button/dialog payloads (required, >= 32 chars). Generate: openssl rand -hex 32
HMAC_KEY=
# This service's URL as Mattermost sees it (button clicks are posted here).
SERVICE_URL=http://attendance:8080
# Days the daily jobs (reminder, summaries) run. Default mon,tue,wed,thu,fri.
WORKDAYS=mon,tue,wed,thu,fri
# Auto-close sessions open longer than this many hours. Default 16.
MAX_SESSION_HOURS=16

# --- GitHub (tasks + end-of-day reports; optional) ---
# Leave GITHUB_APP_ID empty to turn GitHub features off.
# App ID: GitHub → org Settings → Developer settings → GitHub Apps → your App.
GITHUB_APP_ID=
# Path INSIDE the container; put the file at ./secrets/github-app.pem on the host.
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# GITHUB_API_URL=https://api.github.com
# Open issues in a team's org assigned to a linked member are added to the
# team's Project automatically (any repo). Default true.
# GITHUB_ADD_ASSIGNED_TO_BOARD=true
# How often (minutes) the bot sweeps for such issues; 0 = only when members
# run /att in, /att tasks or open the EOD form. Default 2.
# GITHUB_BOARD_SWEEP_MINUTES=2

# --- Attendance panel (Mattermost plugin com.bittrix.attendance; optional) ---
# Shared with the plugin's "Shared secret" setting. Empty: the panel API is off.
# Generate with: openssl rand -hex 32
PLUGIN_SECRET=

# --- Teams that run attendance (HQ is NOT listed) ---
# Team id: System Console → Teams → <team>, or GET /api/v4/teams/name/<slug>
# Slash token: shown when you create the /att command in that team.
# Channel ids (#attendance, #attendance-admin): channel menu → View Info.
# Several teams may share one GitHub org and/or Project.
TEAMS=inkyank,seechanlabs,bittrixtechnologies,creatorscult

TEAM_INKYANK_ID=
TEAM_INKYANK_NAME=InkYank
TEAM_INKYANK_SLASH_TOKEN=
TEAM_INKYANK_ATTENDANCE_CHANNEL_ID=
TEAM_INKYANK_ADMIN_CHANNEL_ID=
# GitHub org login and its Project (v2) number, e.g. github.com/orgs/<org>/projects/<number>
TEAM_INKYANK_GITHUB_ORG=
TEAM_INKYANK_GITHUB_PROJECT=

TEAM_SEECHANLABS_ID=
TEAM_SEECHANLABS_NAME=Seechanlabs
TEAM_SEECHANLABS_SLASH_TOKEN=
TEAM_SEECHANLABS_ATTENDANCE_CHANNEL_ID=
TEAM_SEECHANLABS_ADMIN_CHANNEL_ID=
TEAM_SEECHANLABS_GITHUB_ORG=
TEAM_SEECHANLABS_GITHUB_PROJECT=

TEAM_BITTRIXTECHNOLOGIES_ID=
TEAM_BITTRIXTECHNOLOGIES_NAME=Bittrix Technologies
TEAM_BITTRIXTECHNOLOGIES_SLASH_TOKEN=
TEAM_BITTRIXTECHNOLOGIES_ATTENDANCE_CHANNEL_ID=
TEAM_BITTRIXTECHNOLOGIES_ADMIN_CHANNEL_ID=
TEAM_BITTRIXTECHNOLOGIES_GITHUB_ORG=
TEAM_BITTRIXTECHNOLOGIES_GITHUB_PROJECT=

TEAM_CREATORSCULT_ID=
TEAM_CREATORSCULT_NAME=CreatorsCult
TEAM_CREATORSCULT_SLASH_TOKEN=
TEAM_CREATORSCULT_ATTENDANCE_CHANNEL_ID=
TEAM_CREATORSCULT_ADMIN_CHANNEL_ID=
TEAM_CREATORSCULT_GITHUB_ORG=
TEAM_CREATORSCULT_GITHUB_PROJECT=
