# Copy to .env and fill in. Never commit .env.

# --- Mattermost ---
# Base URL of Mattermost as seen from inside Docker (service name + port).
MM_URL=http://mattermost:8065
# Access token of the `attendance` bot (System Console → Integrations → Bot Accounts).
MM_BOT_TOKEN=
# Name of the existing Docker network Mattermost is on (`docker network ls`).
MM_DOCKER_NETWORK=mattermost_default

# --- Database ---
POSTGRES_PASSWORD=
# DATABASE_URL is built by docker-compose.yml from POSTGRES_PASSWORD.
# Set it yourself only when running outside compose:
# DATABASE_URL=postgres://attendance:PASSWORD@localhost:5432/attendance?sslmode=disable

# --- Service ---
LISTEN_ADDR=:8080
TIMEZONE=Asia/Kolkata
# Signs button/dialog payloads (required, >= 32 chars). Generate: openssl rand -hex 32
HMAC_KEY=
# This service's URL as Mattermost sees it (button clicks are posted here).
SERVICE_URL=http://attendance:8080

# --- Teams that run attendance (HQ is NOT listed) ---
# Team id: System Console → Teams → <team>, or GET /api/v4/teams/name/<slug>
# Slash token: shown when you create the /att command in that team.
# Channel ids: channel menu → View Info (needed from phase 3).
TEAMS=inkyank,seechanlabs,bittrixtechnologies,creatorscult

TEAM_INKYANK_ID=
TEAM_INKYANK_NAME=InkYank
TEAM_INKYANK_SLASH_TOKEN=
TEAM_INKYANK_ATTENDANCE_CHANNEL_ID=
TEAM_INKYANK_ADMIN_CHANNEL_ID=

TEAM_SEECHANLABS_ID=
TEAM_SEECHANLABS_NAME=Seechanlabs
TEAM_SEECHANLABS_SLASH_TOKEN=
TEAM_SEECHANLABS_ATTENDANCE_CHANNEL_ID=
TEAM_SEECHANLABS_ADMIN_CHANNEL_ID=

TEAM_BITTRIXTECHNOLOGIES_ID=
TEAM_BITTRIXTECHNOLOGIES_NAME=Bittrix Technologies
TEAM_BITTRIXTECHNOLOGIES_SLASH_TOKEN=
TEAM_BITTRIXTECHNOLOGIES_ATTENDANCE_CHANNEL_ID=
TEAM_BITTRIXTECHNOLOGIES_ADMIN_CHANNEL_ID=

TEAM_CREATORSCULT_ID=
TEAM_CREATORSCULT_NAME=CreatorsCult
TEAM_CREATORSCULT_SLASH_TOKEN=
TEAM_CREATORSCULT_ATTENDANCE_CHANNEL_ID=
TEAM_CREATORSCULT_ADMIN_CHANNEL_ID=
